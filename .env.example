# Only local development credentials; never reuse for a public deployment.
POSTGRES_PASSWORD=wardrobe_local_dev
WEB_PORT=8088
DB_PORT=55438
PROVIDER_MODE=fake
CUTOUT_ENABLED=true
# Weather is independent of PROVIDER_MODE; empty credentials enable manual weather only.
# Host from QWeather console, e.g. abcxyz.qweatherapi.com (no scheme/path).
QWEATHER_HOST=
# Use one method. TOKEN is a server-generated JWT; refresh it before expiry.
QWEATHER_API_KEY=
QWEATHER_TOKEN=
# Qwen: set PROVIDER_MODE=qwen and provide the regional compatible-mode/v1 URL from your console.
QWEN_BASE_URL=
QWEN_API_KEY=
